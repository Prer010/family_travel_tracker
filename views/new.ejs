<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Family Member</title>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.8.0/fonts/remixicon.css" rel="stylesheet" />
  <link rel="stylesheet" href="./styles/main.css">
  <link rel="stylesheet" href="./styles/new.css">
</head>

<body>
  <!-- Back Button -->
  <a href="/dashboard" class="back-button" title="Back to Dashboard">
    <i class="ri-arrow-left-line"></i>
  </a>

  <!-- Card Container -->
  <div class="card-container">
    <h1>Add a Family Member</h1>

    <% if (locals.error) { %>
      <div class="error-message">
        <%= error %>
      </div>
      <% } %>

        <form action="/new" method="post">
          <p>Name</p>
          <input type="text" name="name" placeholder="Enter family member name" required>

          <p>Pick a color:</p>
          <div class="color-picker">
            <input type="radio" name="color" id="red" value="red" required />
            <label for="red"><span class="radio red"></span></label>

            <input type="radio" name="color" id="orange" value="orange" />
            <label for="orange"><span class="radio orange"></span></label>

            <input type="radio" name="color" id="yellow" value="yellow" />
            <label for="yellow"><span class="radio yellow"></span></label>

            <input type="radio" name="color" id="olive" value="olive" />
            <label for="olive"><span class="radio olive"></span></label>

            <input type="radio" name="color" id="green" value="green" />
            <label for="green"><span class="radio green"></span></label>

            <input type="radio" name="color" id="teal" value="teal" />
            <label for="teal"><span class="radio teal"></span></label>

            <input type="radio" name="color" id="blue" value="blue" />
            <label for="blue"><span class="radio blue"></span></label>

            <input type="radio" name="color" id="violet" value="violet" />
            <label for="violet"><span class="radio violet"></span></label>

            <input type="radio" name="color" id="purple" value="purple" />
            <label for="purple"><span class="radio purple"></span></label>

            <input type="radio" name="color" id="pink" value="pink" />
            <label for="pink"><span class="radio pink"></span></label>
          </div>

          <button type="submit" class="submit-button">Add Family Member</button>
        </form>
  </div>
</body>

</html>